# Supabase Environment Variables
# Get these from your Supabase project settings at https://app.supabase.com

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Your Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="xxx"
# Base URL used to build absolute links in MCP tool results (optional)
NEXT_PUBLIC_SITE_URL="https://your-site.example"
