generator client {
  provider = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model dhsjr {
  character_id       String  @id @map("ID")
  book_id            String? @map("資料番号")
  book_name          String? @map("資料名")
  index_in_book      BigInt  @map("資料内漢字番号")
  word_index_in_book String? @map("資料内漢語番号")
  character          String? @map("単字_見出し")
  character_original String? @map("単字_出現形")
  word               String? @map("漢語_見出し")
  word_original      String? @map("漢語_出現形")
  word_alphabet      String? @map("漢語_alphabet")

  word_type        String? @map("語種")
  pos_in_word      String? @map("漢語内位置")
  len              String? @map("単字長")
  shoten           String? @map("声点")
  shoten_word      String? @map("声点型")
  kana             String? @map("仮名注")
  word_kana        String? @map("仮名型")
  fanqie           String? @map("反切")
  ruion            String? @map("類音")
  hakase           String? @map("節博士")
  etc              String? @map("その他")
  position_in_book String? @map("出現位置")
  notes            String? @map("備考")
  // @@index([漢語_見出し], map: "pgroonga_dhsjr_index")
}